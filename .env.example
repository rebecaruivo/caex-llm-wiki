# Copie para .env e preencha. Nunca publique o arquivo .env.
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Histórico compartilhado de chats (Supabase). Crie as tabelas com supabase/schema.sql.
# A URL termina em .supabase.co, sem /rest/v1.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=cole_sua_chave_secreta_aqui

# Onde guardar lacunas e erros informados na interface. Use um dos dois.
# Local: grava em um arquivo dentro do projeto.
REGISTROS_ARQUIVO=registros.jsonl
# Produção: envia para um webhook, como um fluxo do n8n.
# REGISTROS_WEBHOOK_URL=

# Ingestão. A chave do worker fica separada da chave do oráculo.
# GEMINI_API_KEY_INGEST=cole_sua_chave_aqui

# Switches operacionais (padrões da especificação §11.1).
# INGEST_ABERTO=false
# INGEST_MAX_DIA=20
# INGEST_MAX_POR_IP=3
