# Copie para .env e preencha. Nunca publique o arquivo .env.
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Histórico compartilhado de chats (Supabase). Crie as tabelas com supabase/schema.sql.
# A URL termina em .supabase.co, sem /rest/v1.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=cole_sua_chave_secreta_aqui

# Onde guardar lacunas e erros informados na interface. Use um dos dois.
# Local: grava em um arquivo dentro do projeto.
REGISTROS_ARQUIVO=registros.jsonl
# Produção: envia para um webhook, como um fluxo do n8n.
# REGISTROS_WEBHOOK_URL=

# Ingestão. A chave do worker fica separada da chave do oráculo.
# GEMINI_API_KEY_INGEST=cole_sua_chave_aqui

# Switches operacionais (padrões da especificação §11.1).
# INGEST_ABERTO=false
# INGEST_MAX_DIA=20
# INGEST_MAX_POR_IP=3

# Ingestão: rode também supabase/ingest.sql.
# Token da Vercel só para disparar ingerir.yml (Actions: write).
# GITHUB_DISPATCH_TOKEN=cole_o_token_de_dispatch_aqui
# Sal para HMAC dos IPs e das consultas de andamento.
# INGEST_SALT=cole_um_sal_aleatorio_aqui
# Turnstile: obrigatórias quando INGEST_ABERTO=true. Use as chaves de teste no local.
# TURNSTILE_SITE_KEY=cole_a_chave_publica_do_turnstile
# TURNSTILE_SECRET_KEY=cole_a_chave_secreta_do_turnstile
# Workflow manual de manutenção (ticket #7): Authorization: Bearer $CRON_SECRET.
# CRON_SECRET=cole_um_segredo_aqui
# Notificações da gestão (ticket #7), sem UUID nem texto bruto.
# NOTIFICACOES_WEBHOOK_URL=
# NOTIFICACOES_WEBHOOK_SECRET=
